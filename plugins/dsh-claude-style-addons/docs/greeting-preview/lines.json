[["Good morning, {name}!","早啊主人 本鲸等你半天了"],["Happy {weekday}, {name}.","周三好呀 谁也别想偷懒"],["What are you working on?","我游上来了 先啃哪块"],["Morning, {name}. What’s first?","醒了就干 这才对"],["Fresh start, {name}?","别想了 先干五分钟"],["What’s on the agenda today?","先泡杯茶 活跑不掉"],["Good afternoon, {name}.","中午了 主人你吃了吗"],["Midday check-in, {name}?","过一半了 别慌"],["Coffee and Claude time?","我陪你 不许摸鱼"],["How’s the day going, {name}?","犯困就摸摸鱼 我准了"],["Afternoon, {name}. What’s next?","那个问题 还在你脑子里吧"],["Evening, how are things?","天黑了 累不累"],["Good evening, {name}.","夜里好 烁丞 我陪你游"],["How was your day, {name}?","今天就这样 明天再说"],["Winding down, or just getting started?","该收工了 别硬撑"],["You are here!","这么晚还醒着 咱俩都不正常"],["Hello, night owl.","月亮不睡我不睡"],["Burning the midnight oil, {name}?","又熬夜 你上次也这么说"],["Still up, {name}?","睡了没 没有就陪我聊"],["Back at it, {name}?","欢迎回来 主人想我没"],["Welcome back, {name}.","活儿还在原地 我没动"],["Hey there, {name}.","今天搞点什么大事"],["What shall we build?","闲着也是闲着 干点没用的"]]